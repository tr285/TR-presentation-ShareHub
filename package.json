{
  "name": "tr-presentation-sharehub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SIGNAL,NEXT\" -c \"cyan,magenta\" \"tsx server/index.ts\" \"next dev\"",
    "dev:frontend": "next dev",
    "dev:server": "tsx watch server/index.ts",
    "build": "next build",
    "start": "next start",
    "server": "tsx server/index.ts",
    "server:dev": "tsx watch server/index.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:signaling": "tsx --test tests/signaling.test.ts",
    "test:security": "tsx --test tests/security.test.ts",
    "test:e2e": "tsx --test tests/e2e-flows.test.ts",
    "test:unit": "tsx --test tests/signaling.test.ts tests/webrtc-config.test.ts tests/security.test.ts tests/e2e-flows.test.ts",
    "test": "npm run lint && npm run typecheck && npm run test:unit"
  },
  "dependencies": {
    "next": "16.4.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
