# ==============================================================================
# TR Presentation ShareHub - Environment Configuration Template
# ==============================================================================

# Signaling Server URL (Default: http://localhost:3001)
# For cross-device LAN or public deployment, set this to the reachable IP or domain
# (e.g. http://192.168.1.100:3001 or https://signaling.yourdomain.com)
NEXT_PUBLIC_SIGNALING_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# WebRTC ICE Server Configuration (STUN / TURN)
# ------------------------------------------------------------------------------

# Optional custom STUN servers (comma-separated).
# Default fallback includes Google's public STUN servers:
# stun:stun.l.google.com:19302, stun:stun1.l.google.com:19302, stun:stun2.l.google.com:19302
# NEXT_PUBLIC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN Relay Servers (comma-separated URLs).
# Required when peers are on restrictive enterprise firewalls, cellular 4G/5G,
# or symmetric NATs where direct P2P hole punching fails.
# Supports standard turn: (UDP/TCP 3478) and secure turns: (TLS 443).
# NEXT_PUBLIC_TURN_URL=turn:turn.yourdomain.com:3478?transport=udp,turns:turn.yourdomain.com:443?transport=tcp
# NEXT_PUBLIC_TURN_USERNAME=sharehub_user
# NEXT_PUBLIC_TURN_CREDENTIAL=your_secure_turn_password

# ICE Transport Policy: 'all' (default) or 'relay'.
# Use 'relay' to force all media traffic through TURN servers for compliance testing.
# NEXT_PUBLIC_ICE_TRANSPORT_POLICY=all

# ------------------------------------------------------------------------------
# Signaling Server Port & Security (Used by Node.js server)
# ------------------------------------------------------------------------------
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_MSGS_PER_10S=120
RATE_LIMIT_CREATES_PER_MIN=10
